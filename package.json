{
  "name": "minimax-code",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "trustedDependencies": [
    "esbuild",
    "node-pty"
  ],
  "description": "Standalone MiniMax Code TUI with managed accounts, BYOK models, cloud tools, plugins and ACP.",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "third_party/pi-mono/packages/agent",
    "third_party/pi-mono/packages/ai",
    "third_party/pi-mono/packages/coding-agent",
    "third_party/pi-mono/packages/tui",
    "packages/agent-core",
    "packages/agent-extension",
    "packages/agent-runtime",
    "packages/agent-tools",
    "packages/agent-modules/background-task",
    "packages/browser-core",
    "packages/config",
    "packages/agent-modules/context-manager",
    "packages/agent-modules/conversation-contract",
    "packages/agent-modules/cron",
    "packages/agent-modules/goal",
    "packages/local-runtime",
    "packages/local-runtime-v2",
    "packages/agent-modules/mcp",
    "packages/agent-modules/permission",
    "packages/agent-modules/plugin-hooks",
    "packages/protocol",
    "packages/agent-modules/runaway-guard",
    "packages/agent-modules/session-report",
    "packages/shared",
    "packages/agent-modules/skills",
    "packages/agent-modules/system-reminder",
    "packages/tui",
    "third_party/sandbox-runtime",
    "packages/oauth-core",
    "packages/oauth-lease-protocol",
    "packages/mcode-tools-host"
  ],
  "engines": {
    "node": ">=22.19 <23 || >=24.2 <27",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "package:exe": "bun scripts/package-exe.mjs",
    "release:cli": "bun scripts/release-cli.mjs",
    "start": "bun dist/cli.js",
    "mcode": "bun dist/cli.js",
    "verify": "bun scripts/verify.mjs",
    "test:smoke": "bun scripts/run-bun-tests.mjs test/smoke.test.mjs",
    "test:bun": "bun scripts/run-bun-tests.mjs",
    "bench:native": "bun scripts/perf/bun-native-bench.mjs",
    "test:policy": "bun scripts/run-vitest-suite.mjs policy",
    "test:byok": "bun scripts/run-bun-tests.mjs test/byok.test.mjs",
    "check:standalone": "bun scripts/check-standalone-boundary.mjs",
    "check:comments": "bun scripts/check-source-comments.mjs",
    "check:tsconfig": "bun scripts/gen-tsconfig-paths.mjs",
    "gen:tsconfig": "bun scripts/gen-tsconfig-paths.mjs --write",
    "typecheck": "bun x tsc -p tsconfig.standalone.json",
    "test:sandbox": "bun scripts/run-vitest-suite.mjs sandbox",
    "test:status-contract": "bun scripts/run-vitest-suite.mjs status-contract",
    "check:source": "bun scripts/source-inventory.mjs",
    "check:plugin": "bun tools/plugins/validate-plugin.mjs",
    "test:capabilities": "bun scripts/run-vitest-suite.mjs capability",
    "test:windows": "bun scripts/run-vitest-suite.mjs windows",
    "test:artifact": "bun scripts/run-bun-tests.mjs test/public-artifact.test.mjs",
    "test:release-tools": "bun scripts/run-bun-tests.mjs test/source-sync.test.mjs",
    "lint": "bun run lint:tui",
    "lint:tui": "bun x eslint packages/tui/src packages/tui/test --ext .ts,.mjs --quiet"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "shx": "^0.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "tar": "7.5.22",
    "vite": "7.3.6",
    "eslint": "8.57.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "postject": "1.0.0-alpha.6"
  },
  "license": "MIT",
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@modelcontextprotocol/sdk>@hono/node-server": "2.0.12",
    "minimatch@>=10.2.5>brace-expansion": "5.0.9",
    "ajv>fast-uri": "3.1.6",
    "express-rate-limit>ip-address": "10.4.0",
    "vite": "7.3.6",
    "hono": "4.13.5"
  }
}
